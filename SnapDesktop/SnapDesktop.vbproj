<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <AssemblyName>SnapDesktop</AssemblyName>
   <RootNamespace>SnapDesktop</RootNamespace>
   <MyType>WindowsFormsWithCustomSubMain</MyType>
   <OutputType>WinExe</OutputType>
   <StartupObject>SnapDesktop.MainProgram</StartupObject>
   <!-- <TargetFramework>net10.0-windows</TargetFramework> -->
   <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
   <UseWindowsForms>true</UseWindowsForms>
   <Platforms>x86;x64</Platforms>   
</PropertyGroup>

<PropertyGroup Condition="'$(TargetFramework)' != ''">
   <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
   <OutputPath>..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
   <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
</PropertyGroup>

<PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
   <PlatformTarget>$(Platform)</PlatformTarget>
</PropertyGroup>


<ItemGroup>
   <Import Include="System.Data" />
   <Import Include="System.Drawing" />
   <Import Include="System.Windows.Forms" />
 </ItemGroup>


<ItemGroup>
  <Folder Include="API\" />
</ItemGroup>

</Project>